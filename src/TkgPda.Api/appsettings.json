{
  "Authentication": {
    "Jwt": {
      "Issuer": "tkg-pda",
      "Audience": "tkg-pda-clients",
      "ExpiryMinutes": 60,
      "ClockSkewSeconds": 30
    },
    "FieldSession": {
      "LeaseSeconds": 120,
      "HeartbeatSeconds": 30
    }
  },
  "Rds": {
    "Enabled": true,
    "DispatchEnabled": false,
    "BaseUrl": "http://127.0.0.1:8080",
    "TimeoutSeconds": 5,
    "CallbackUrl": "",
    "EmptyContentValue": "",
    "FullContentValue": "",
    "AllowInsecureRemoteHttp": false,
    "WorkerIntervalSeconds": 3,
    "WorkSiteFreshnessSeconds": 300,
    "AlarmObservationIntervalSeconds": 10
  },
  "RdsCore": {
    "BaseUrl": "http://127.0.0.1:8088",
    "TimeoutSeconds": 5,
    "AllowInsecureRemoteHttp": false
  },
  "RdsCoreDiscovery": {
    "Enabled": true
  },
  "RdsCoreExecution": {
    "Enabled": true,
    "Mode": "RDSCORE_NATIVE_ORDER"
  },
  "M4": {
    "Enabled": false,
    "ReadEnabled": false,
    "DispatchEnabled": false,
    "BaseUrl": "",
    "AllowedOrigins": [],
    "AllowInsecureRemoteHttp": false,
    "TimeoutSeconds": 10,
    "MaxReadRetries": 1,
    "RetryBaseDelayMilliseconds": 100,
    "AppId": "",
    "AppKey": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://127.0.0.1:8085",
      "http://127.0.0.1:7357",
      "http://localhost:8085",
      "http://localhost:7357"
    ]
  },
  "DeviceNotifications": {
    "LongPollSeconds": 25,
    "LeaseSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
